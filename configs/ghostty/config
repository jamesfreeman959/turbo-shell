# Ghostty configuration
# Docs: https://ghostty.org/docs/config

# ── Font ──────────────────────────────────────────────────────────────────────
font-family = "MonaspiceNe Nerd Font"
font-size = 14
font-feature = calt    # contextual alternates (Monaspace ligatures)
font-feature = ss01    # coding ligatures group 1
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08

# ── Theme ─────────────────────────────────────────────────────────────────────
# To find exact name: ghostty +list-themes | grep -i tokyo
theme = tokyonight

# Slight transparency — remove if you prefer fully opaque
background-opacity = 0.95
background-blur-radius = 20

# ── Cursor ────────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Window ────────────────────────────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = tabs

# ── Behaviour ─────────────────────────────────────────────────────────────────
# needed for Alt keybindings in nvim/tmux
macos-option-as-alt = true
# explicit copy only
copy-on-select = false
# no "are you sure?" on close
confirm-close-surface = false

# ── Shell integration ─────────────────────────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ── Terminal ──────────────────────────────────────────────────────────────────
# xterm-256color gives widest compatibility with tmux and mosh
# tmux handles 24-bit color upgrading internally
term = xterm-256color

# ── Keybindings ───────────────────────────────────────────────────────────────
# New tab inherits cwd
keybind = cmd+t=new_tab
keybind = cmd+shift+t=new_tab
